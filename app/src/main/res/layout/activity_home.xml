<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".HomeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dashboardUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semi_bold"
                android:text="Hello Bhanu"
                android:textColor="@android:color/black"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="What are you cooking today?"
                android:textColor="@color/gray2"
                android:textSize="14sp" />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="52dp"
            android:layout_height="52dp"
            app:cardBackgroundColor="@color/secondary40"
            app:cardCornerRadius="26dp"
            app:cardElevation="4dp">

            <ImageView
                android:id="@+id/userProfileImage"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:background="@drawable/rounded_image"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@drawable/profile_image" />
        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="90dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/searchBox"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginEnd="18dp"
            android:layout_weight="1"
            android:background="@drawable/search_background"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_search_icon"
                app:tint="@color/gray3" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="Search recipe..."
                android:paddingStart="8dp"
                android:gravity="start|center"
                android:textColor="@android:color/black"
                android:textColorHint="@color/gray3"
                android:textSize="16sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/filterRecipes"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/filter_button_background"
            android:elevation="4dp"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/filter"
            app:tint="@color/white" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/category_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="170dp"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/categoryContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        </LinearLayout>
    </HorizontalScrollView>

    <!--Recipes list starts-->

    <ScrollView
        android:id="@+id/scroll_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="220dp"
        app:layout_constraintTop_toBottomOf="@id/category_scroll"
        tools:ignore="NotSibling">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingBottom="120dp">

            <TextView
                android:id="@+id/featuredRecipes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/poppins_semi_bold"
                android:paddingStart="24dp"
                android:text="Featured Recipes"
                android:textColor="@color/black"
                android:textSize="20sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_featured_recipes"
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="24dp"
                android:paddingEnd="12dp"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/tv_no_featured_recipes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="No recipes found"
                android:textAlignment="center"
                android:textColor="@color/gray3"
                android:visibility="gone" />

            <TextView
                android:id="@+id/new_recipes_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semi_bold"
                android:paddingStart="24dp"
                android:paddingTop="18dp"
                android:text="New Recipes"
                android:textColor="@color/black"
                android:textSize="20sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_new_recipes"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingHorizontal="12dp"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/tv_no_new_recipes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="No recipes found"
                android:textAlignment="center"
                android:textColor="@color/gray3"
                android:visibility="gone" />

            <!-- Quick & Easy Section -->
            <TextView
                android:id="@+id/quick_easy_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/poppins_semi_bold"
                android:paddingStart="24dp"
                android:paddingTop="16dp"
                android:text="Quick &amp; Easy"
                android:textColor="@color/black"
                android:textSize="20sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_quick_easy"
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="24dp"
                android:paddingEnd="12dp"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/tv_no_quick_easy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="No recipes found"
                android:textAlignment="center"
                android:textColor="@color/gray3"
                android:visibility="gone" />

            <!-- Veg Recipes Section -->
            <TextView
                android:id="@+id/veg_recipes_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semi_bold"
                android:paddingStart="24dp"
                android:paddingTop="16dp"
                android:text="Vegetarian Recipes"
                android:textColor="@color/black"
                android:textSize="20sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_veg_recipes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingHorizontal="16dp"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/tv_no_veg_recipes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="No recipes found"
                android:textAlignment="center"
                android:textColor="@color/gray3"
                android:visibility="gone" />

            <!-- Non-Veg Recipes Section -->
            <TextView
                android:id="@+id/non_veg_recipes_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semi_bold"
                android:paddingStart="24dp"
                android:paddingTop="18dp"
                android:text="Non-Vegetarian Recipes"
                android:textColor="@color/black"
                android:textSize="20sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_non_veg_recipes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingHorizontal="16dp"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/tv_no_non_veg_recipes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="No recipes found"
                android:textAlignment="center"
                android:textColor="@color/gray3"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <!--Recipes list ends-->

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">

        <include layout="@layout/bottom_navigation_bar" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_add_recipe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center|bottom"
            android:layout_marginBottom="4dp"
            android:backgroundTint="@color/primary100"
            android:contentDescription="Add recipe"
            android:src="@drawable/plussign"
            app:borderWidth="0dp"
            app:elevation="12dp"
            app:fabCustomSize="60dp"
            app:maxImageSize="24dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.FAB.Circle"
            app:tint="@android:color/white" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <LinearLayout
        android:id="@+id/loader_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/progressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Loading recipes..."
            android:textSize="16sp"
            android:textColor="@color/black" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

